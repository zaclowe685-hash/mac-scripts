#!/usr/bin/env bash
# deepseek — run Claude Code against Zac's DeepSeek account (V4 Flash / V4 Pro)
#
# IMPORTANT: ~/scripts is the PUBLIC mac-scripts repo.
# This file must never contain the API key. It reads ~/.config/deepseek/key at runtime.
#
#   deepseek          deepseek-v4-flash everywhere (main thread + cheap tier)
#   deepseek pro      deepseek-v4-pro on the main thread, flash for the cheap tier
#   deepseek peak     is DeepSeek in its doubled-price window right now (Sydney time)?
#   deepseek check    preflight: key + a real API ping + a timed speed probe (tok/s)
#   deepseek balance  how many dollars are left on the account
#
# Anything after the mode is passed straight through to claude, e.g.
#   deepseek -p "summarise every TODO in this repo"
#
# These set variables for THIS PROCESS ONLY. Plain `claude` still goes to
# Anthropic on the normal subscription.

set -euo pipefail

BASE_URL="https://api.deepseek.com/anthropic"
API_ROOT="https://api.deepseek.com"
KEY_FILE="$HOME/.config/deepseek/key"
BIG_MODEL="deepseek-v4-pro"
FAST_MODEL="deepseek-v4-flash"

die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
note() { printf '\033[2m%s\033[0m\n' "$*" >&2; }

read_key() {
  [ -f "$KEY_FILE" ] || die "No DeepSeek key at $KEY_FILE — create it with: echo 'sk-...' > $KEY_FILE"
  KEY="$(tr -d '[:space:]' < "$KEY_FILE")"
  [ -n "$KEY" ] || die "$KEY_FILE is empty."
}

# Peak = Mon-Fri 01:00-04:00 and 06:00-10:00 UTC (prices double).
# In Sydney (AEST, UTC+10) that is 11:00-14:00 and 16:00-20:00 on weekdays.
peak_status() {
  python3 - <<'PY'
import datetime as dt
now = dt.datetime.now(dt.timezone.utc)
loc = now.astimezone()
peak = now.weekday() < 5 and (1 <= now.hour < 4 or 6 <= now.hour < 10)
print(f"UTC   : {now:%a %d %b %H:%M}")
print(f"Local : {loc:%a %d %b %H:%M %Z}")
print()
print("\033[33mPEAK — prices are DOUBLED right now\033[0m (Flash $0.44 in / $1.32 out per M)."
      if peak else
      "\033[32mOFF-PEAK\033[0m — half price right now (Flash $0.22 in / $0.66 out per M).")
print("(Peak = Mon-Fri 11:00-14:00 and 16:00-20:00 Sydney time.)")
PY
}

balance() {
  read_key
  curl -s -m 20 "$API_ROOT/user/balance" -H "Authorization: Bearer $KEY"; echo
}

run_check() {
  read_key
  echo "Base URL : $BASE_URL"
  echo "Key      : ${KEY:0:6}...${KEY: -4} (from $KEY_FILE)"
  echo
  for m in "$FAST_MODEL" "$BIG_MODEL"; do
    printf '%-20s ' "$m"
    code=$(curl -s -o /tmp/ds-check.$$ -w '%{http_code}' -m 60 \
      "$BASE_URL/v1/messages" \
      -H "Authorization: Bearer $KEY" \
      -H "anthropic-version: 2023-06-01" \
      -H "content-type: application/json" \
      -d "{\"model\":\"$m\",\"max_tokens\":8,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" \
      || echo 000)
    if [ "$code" = "200" ]; then
      printf '\033[32mOK\033[0m\n'
    else
      printf '\033[31mHTTP %s\033[0m — %s\n' "$code" "$(head -c 200 /tmp/ds-check.$$ 2>/dev/null)"
    fi
    rm -f /tmp/ds-check.$$
  done
  echo
  # Speed probe: one fixed 300-token generation, output tokens / wall seconds.
  printf 'Speed probe (%s, 300 tokens)... ' "$FAST_MODEL"
  start=$(python3 -c 'import time;print(time.time())')
  resp=$(curl -s -m 120 "$BASE_URL/v1/messages" \
    -H "Authorization: Bearer $KEY" \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d "{\"model\":\"$FAST_MODEL\",\"max_tokens\":300,\"messages\":[{\"role\":\"user\",\"content\":\"Write a 300 word story about a train.\"}]}")
  end=$(python3 -c 'import time;print(time.time())')
  python3 - "$resp" "$start" "$end" <<'PY'
import json, sys
r = json.loads(sys.argv[1]); t = float(sys.argv[3]) - float(sys.argv[2])
out = r.get("usage", {}).get("output_tokens", 0)
print(f"{out} tokens in {t:.1f}s = \033[1m{out/t:.0f} tok/s\033[0m (includes network + first-token wait)")
PY
  echo
  peak_status
  echo
  printf 'Balance  : '; balance
}

launch() {
  local main_model="$1"; shift
  read_key
  unset ANTHROPIC_API_KEY
  export ANTHROPIC_BASE_URL="$BASE_URL"
  export ANTHROPIC_AUTH_TOKEN="$KEY"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$BIG_MODEL"
  export ANTHROPIC_DEFAULT_SONNET_MODEL="$main_model"
  export ANTHROPIC_DEFAULT_HAIKU_MODEL="$FAST_MODEL"
  export ANTHROPIC_MODEL="$main_model"
  note "DeepSeek session — main thread: $main_model | cheap tier: $FAST_MODEL"
  note "Nothing in this session bills to Anthropic. Plain 'claude' is unaffected."
  exec claude "$@"
}

case "${1:-}" in
  pro)      shift; launch "$BIG_MODEL" "$@" ;;
  peak)     peak_status ;;
  check)    run_check ;;
  balance)  balance ;;
  -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)        launch "$FAST_MODEL" "$@" ;;
esac
